# ============================================================
# WARIS.DEV CUSTOM CMS — MongoDB + Prisma 8
# Copy this file to .env.local and replace the placeholders.
# ============================================================

# --- MongoDB (Prisma 8 / MongoDB Atlas) ------------------------
# Atlas connection string (SRV or standard).  Requires MongoDB 7+.
# Example (SRV): mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/cms
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cms?retryWrites=true&w=majority"

# --- NextAuth.js ----------------------------------------------
# Random secret used to sign the JWT and the session cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Vercel Blob (project / blog cover images) ----------------
# The Blob token with write access.  Create it in the Vercel dashboard at
# https://vercel.com/<account>/<project>/settings/secrets, then paste it here.
BLOB_READ_ONLY_TOKEN="vercel-blob-token"

# --- Admin user (used by scripts/seed-admin.js) --------------
# Create once, then sign in at /admin/login.
ADMIN_EMAIL="admin@waris.dev"
ADMIN_PASSWORD="super-secret"
ADMIN_NAME="Waris Ali"

# --- Public site ----------------------------------------------
SITE_URL="https://waris.dev"

# --- Contact form email ---------------------------------------
# Gmail App Password: https://myaccount.google.com/apppasswords (enable 2FA first)

# Where you receive contact-form messages (the owner inbox)
CONTACT_TO=waris0543@gmail.com

# SMTP login (this Gmail account SENDS the emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=waris0543@gmail.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD

# Display name shown on outgoing email
MAIL_FROM_NAME=Waris.dev
